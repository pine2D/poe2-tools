{
  "name": "@poe2-tools/ui-theme",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./index.css": "./src/index.css",
    "./tokens.css": "./src/tokens.css",
    "./l1.css": "./src/l1.css",
    "./motif.css": "./src/generated/motif.css",
    "./components/*": "./src/components/*",
    "./fonts.css": "./fonts/fonts.css",
    "./popup-fonts.css": "./fonts/popup.css",
    "./motif": "./src/motif.ts",
    "./selectors": "./src/selectors.ts",
    "./compliance": {
      "types": "./scripts/compliance.d.mts",
      "default": "./scripts/compliance.mjs"
    }
  },
  "scripts": {
    "fonts": "node scripts/build-fonts.mjs",
    "motif": "node scripts/build-motif-css.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "subset-font": "2.9.0"
  }
}
