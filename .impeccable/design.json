      "html": "<a class=\"ds-button\" href=\"#build\">打开构筑汉化 <span aria-hidden=\"true\">→</span></a>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;min-height:48px;padding:11px 20px;background:var(--brand,#d6b887);color:var(--brand-ink,#241e15);border:1px solid var(--brand,#d6b887);border-radius:4px;font:600 14px/1.65 var(--font-zh-cn,system-ui);text-decoration:none;transition:background-color 140ms,color 140ms}.ds-button:hover{background:var(--text,#f0f2f5);color:var(--surface-0,#17191c);border-color:var(--text,#f0f2f5)}.ds-button:active{transform:scale(.96)}.ds-button:focus-visible{outline:2px solid var(--accent,#b4c9ee);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}.ds-button:active{transform:none}}"
